/config.json

# Host-access credentials. .rsh/ holds the deployment host's password (.rsh/pass)
# and the askpass/ssh/scp wrappers that read it. A literal password default in
# .rsh/run is how this host's root password once reached the public repository,
# so the whole directory stays out of git.
.rsh/

# Database
*.db
*.sqlite

# Logs
*.log
logs/

# Build
build/
dist/
tmp_aiclient/

# Test
test/

# Local staticcheck cache (used when the default cache directory is not writable)
.sccache/

# Local Go module cache and GOPATH, used when the shared locations are not
# writable. They hold a full copy of every dependency plus a vendor tree, so a
# stray `git add -A` would stage hundreds of megabytes of third-party source.
.gomodcache/
.gopath/

# Reference clones of upstream projects used for parity audits (.upstream/) and
# the per-area audit reports they produce (.audit/). Both are working material;
# the summary that matters lives in docs/.
.upstream/
.audit/


# Local cross-compiled deploy artifacts (built by the deploy step, not source)
dist/

# Local operational material: host-access helpers (.tools/askpass.sh holds the
# deployment host's root password), staged binaries (.deploy-stage/) and
# one-off analysis dumps. Same reason as .rsh/ below — this directory has no
# business being in a public repository.
.tools/
.deploy-stage/
function_analysis_report.md

# Local one-off diagnostic output and raw live verification records
/docs/diagnostics/
/docs/verification/

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*
